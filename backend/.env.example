APP_NAME=Behavioral Authentication Platform
APP_ENV=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
MODEL_STORAGE_DIR=backend/models
LOCAL_DATA_DIR=backend/data
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
###############################
# Google Sheets / Apps Script
###############################
# When `GOOGLE_SHEETS_MODE=local` the app writes events to the local spool
# files under `backend/data/sheets_spool/` for manual review and retry.
# Set `GOOGLE_SHEETS_MODE=live` to enable live writes using a service
# account or the Apps Script webhook (see below).

# Spreadsheet ID (from the spreadsheet URL: /d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Full spreadsheet URL (optional)
GOOGLE_SHEETS_SPREADSHEET_URL=

# Mode: `local` (spool) or `live` (attempt to write to Google Sheets)
GOOGLE_SHEETS_MODE=local

# Service account credentials (preferred for server-to-server writes).
# Option A: path to a JSON file (recommended for local development)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Option B: OR paste JSON content directly into this env var (NOT recommended
# for repos). If you use hosted secrets (Vercel/Render), store the JSON there
# and set the path above on the instance.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Apps Script webhook (alternate method): if you deploy the provided script
# as a Web App, set its URL here. The backend will POST events to this URL.
GOOGLE_APPS_SCRIPT_WEBAPP_URL=
# If you use an Apps Script token approach, set it here; otherwise leave blank.
GOOGLE_APPS_SCRIPT_TOKEN=

# NOTE: Do NOT commit service account JSON or real secrets. Add
# `secrets/` and `backend/.env` to your local `.gitignore` (this repo already
# ignores `backend/.env`). When deploying to Render/Vercel set these values in
# the project dashboard as environment variables/secrets.
